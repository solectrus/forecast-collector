##############################################################################
# InfluxDB Configuration
##############################################################################

INFLUX_HOST=eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_SCHEMA=https
INFLUX_PORT=443
INFLUX_TOKEN=the-secret-token-from-influxdata
INFLUX_ORG=john@example.com
INFLUX_BUCKET=my-bucket-name
INFLUX_MEASUREMENT=Forecast

##############################################################################
# Common Configuration
##############################################################################

# Provider selection: forecast.solar, solcast, pvnode
FORECAST_PROVIDER=forecast.solar

# Update interval in seconds (beware of the rate-limit!)
#
# NOTE: For pvnode, this is ignored. The pvnode API says when the next request
#   returns new data, and the collector follows this schedule (see
#   PVNODE_REQUEST_LIMIT below).
FORECAST_INTERVAL=900

##############################################################################
# Single Plane Configuration
# Use this if you have only one roof plane
##############################################################################

# Latitude of location, -90 (south) … 90 (north)
FORECAST_LATITUDE=50.123

# Longitude of location, -180 (west) … 180 (east)
FORECAST_LONGITUDE=6.456

# Plane declination, 0 (horizontal) … 90 (vertical)
FORECAST_DECLINATION=30

# Plane azimuth/orientation
# BEWARE: This differs between providers:
#   For Forecast.solar: -180 … 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
#   For Solcast: Not used, the orientation is defined by the site configuration at solcast.com
#   For pvnode: Orientation of the PV array in degrees from north. 180 is south, and 270 is west
FORECAST_AZIMUTH=20

# Installed modules power in kilo watt
FORECAST_KWP=9.5

##############################################################################
# Multiple Planes Configuration
# Use this if you have multiple roof planes
# Uncomment and adjust the following lines:
##############################################################################

# Define the number of configurations you want to use
# FORECAST_CONFIGURATIONS=2

# For each configuration, set the parameters you want to override
# Example:
#
# FORECAST_0_DECLINATION=30
# FORECAST_0_AZIMUTH=20
# FORECAST_0_KWP=9.5
#
# FORECAST_1_DECLINATION=30
# FORECAST_1_AZIMUTH=-20
# FORECAST_1_KWP=5.85

##############################################################################
# Specific configuration for forecast.solar
# https://doc.forecast.solar/api:estimate
##############################################################################

# Optional API key for registered users of forecast.solar
# FORECAST_SOLAR_APIKEY=abc123

# Damping factors (https://doc.forecast.solar/damping)
# FORECAST_DAMPING_MORNING=0.5
# FORECAST_DAMPING_EVENING=0

# Inverter limit in kW (https://doc.forecast.solar/api#inverter)
# FORECAST_INVERTER=3.5

# Horizon profile (https://doc.forecast.solar/api#horizon)
# FORECAST_HORIZON=0,0,0,0,0,0,10,20,20,20,20,20

##############################################################################
# Specific configuration for solcast.com
# https://toolkit.solcast.com.au/
##############################################################################

# SOLCAST_APIKEY=your-secret-api-key
# SOLCAST_SITE=1111-2222-3333-4444

# For multiple sites:
# FORECAST_CONFIGURATIONS=2
# SOLCAST_0_SITE=1111-2222-3333-4444
# SOLCAST_1_SITE=5555-6666-7777-8888

##############################################################################
# Specific configuration for pvnode.com
# https://www.pvnode.com/docs/forecast
##############################################################################

# The API key for your pvnode account (required)
# PVNODE_APIKEY=your-secret-api-key

# Site ID for the pvnode v2 API (optional)
# A site holds the position and all PV strings of your plant. You create it
# once in the pvnode web app.
#
# If you leave this unset, the collector reads the sites of your account.
# If the account has exactly one usable site, the collector uses that site.
# If the account has more than one, the collector lists them and stops. You
# must then set one of them here.
#
# A site that is inactive or pending deletion is not usable. If the account
# has sites, but none of them is usable, the collector stops too.
#
# If the account has no site at all, the collector uses the legacy v1 API and
# reads the FORECAST_* settings instead.
# WARNING: pvnode shuts the v1 API down on 2026-12-31.
#
# With the v2 API the PV geometry lives on the site. The collector does not
# read FORECAST_LATITUDE, FORECAST_LONGITUDE, FORECAST_DECLINATION,
# FORECAST_AZIMUTH, FORECAST_KWP and PVNODE_*_EXTRA_PARAMS.
# PVNODE_SITE_ID=site_xxxxxxxxxxxxxxxxxxxxxx

# pvnode subscription tier (optional, default: false, v1 API only)
#   false   : free tier (40 requests/month)
#   true    : paid basic tier (1000 requests/month, hourly slots)
#   nowcast : paid Nowcast tier (3000 requests/month, every 10 min during
#             daylight, slot-based at night)
# Nowcast requires approval from pvnode for your account.
# The v2 API reports the limits of your plan itself, so this setting has no
# effect there.
# PVNODE_PAID=true

# Self-imposed monthly request limit (optional)
# The collector follows the schedule that the pvnode API recommends, which uses
# the request budget of your plan. Set a lower limit if you use the same pvnode
# account in other tools (evcc, Home Assistant, ...) and want to keep requests
# available for them. The collector then fetches correspondingly less often.
# A value above the limit of your plan has no effect.
# PVNODE_REQUEST_LIMIT=1000

# Optional: Additional query parameters to append to the API request (v1 only)
# Format: key1=value1&key2=value2 (without leading ? or &)
# https://www.pvnode.com/docs/yield#optional-parameters
#
# Example parameters:
#   diffuse_radiation_model=perez
#   snow_slide_coefficient=0.5 (0.0-0.8, controls snow sliding speed)
#
# Single plane example:
# PVNODE_EXTRA_PARAMS=diffuse_radiation_model=perez&snow_slide_coefficient=0.5
#
# Multiple planes examples:
# PVNODE_0_EXTRA_PARAMS=diffuse_radiation_model=perez
# PVNODE_1_EXTRA_PARAMS=snow_slide_coefficient=0.3
#
# Note on batching: pvnode supports up to 2 planes per API request. To minimize
# API calls, the collector automatically batches planes together when possible.
# However, since extra_params apply to the entire request (not per plane), only
# planes with identical extra_params can be batched. Planes with different
# extra_params will be sent in separate requests.
